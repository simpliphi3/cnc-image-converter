# Copy this file to .env and fill in your keys.
# The setup script will do this for you on first run.

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini / Imagen - https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional overrides
CNC_HOST=127.0.0.1
CNC_PORT=7777
CNC_DATA_DIR=
CNC_ASPIRE_FOLDER=
CNC_DEFAULT_UNITS=mm
CNC_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
# Gemini image model. Default is "Nano Banana 2" (current as of May 2026).
# Alternatives: "gemini-3-pro-image-preview" (higher quality, slower),
# "gemini-2.5-flash-image" (older GA). If Google renames the model again, get
# the current list with: curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GOOGLE_API_KEY"
CNC_GEMINI_MODEL=gemini-3.1-flash-image-preview
